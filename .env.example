DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecomm"
JWT_SECRET="change-this-to-a-long-random-secret"
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
KORAPAY_SECRET_KEY=""
KORAPAY_PUBLIC_KEY=""
APP_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
PORT=4000
TYPEORM_SYNC=true

# Email (Resend) — new order alerts to admin
RESEND_API_KEY=
RESEND_FROM="Atelier <onboarding@resend.dev>"
ADMIN_EMAIL=admin@example.com

# Optional seed overrides (defaults also in src/config/site.ts)
